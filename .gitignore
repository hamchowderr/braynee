
# Dolt database files (added by bd init)
.dolt/
*.db

# Beads / Dolt files (added by bd init)
.beads-credential-key

# Beads proxied shared-server DB (per-machine runtime, not versioned) — cp-uif3.3
.beads/proxieddb/

# Beads issues.jsonl is a disposable export (never the DB), kept fresh on disk
# via export.auto=true for braynee's server-free read-hooks. Untracked here (root,
# not .beads/.gitignore which bd doctor --fix rewrites) so git never conflicts on
# it or blocks checkout. Source of truth is the Dolt DB. See cp-uif3.1.
.beads/issues.jsonl

# Python bytecode (skill scripts)
__pycache__/
*.pyc

# Throwaway dashboard build/verify scratch (screenshots, preview HTML, helper scripts)
mockups/
skills/session-backfill/scripts/project_map.json
