#!/usr/bin/env node
// braynee-self-test — Validate the braynee plugin install end-to-end.
//
// Runs:
//   1. JS/MJS parse check on all hooks, monitors, scripts
//   2. JSON schema validation on hooks.json, monitors.json, plugin.json
//   3. Frontmatter check on every SKILL.md and agents/*.md
//   4. Mock-stdin execution of every hook (verify no crashes)
//   5. Boot-only test of every monitor (3s timeout — checks startup, not loop)
//   6. Bundled scripts dispatch (qmd-wrapper, vault-query, tasknotes, beads-dashboard)
//
// Cross-platform: works on Windows, macOS, Linux. Pure Node, no shell deps.
// Usage:
//   node bin/braynee-self-test                 # from plugin root
//   braynee-self-test                          # if added to PATH
//   braynee-self-test --json                   # machine-readable output
//
// Exit codes:
//   0 — all checks passed
//   1 — at least one check failed (CI should fail the build)

'use strict';

const fs = require('fs');
const os = require('os');
const path = require('path');
const { spawnSync } = require('child_process');

// Find braynee plugin root: this file lives at braynee/bin/braynee-self-test
const PLUGIN_ROOT = path.resolve(__dirname, '..');

const args = process.argv.slice(2);
const jsonMode = args.includes('--json');

const results = {
  parse: { ok: 0, fail: 0, errors: [] },
  configs: { ok: 0, fail: 0, errors: [] },
  frontmatter: { ok: 0, fail: 0, errors: [] },
  hooks: { ok: 0, fail: 0, errors: [] },
  gating: { ok: 0, fail: 0, errors: [] },
  monitors: { ok: 0, fail: 0, errors: [] },
  scripts: { ok: 0, fail: 0, errors: [] },
  unit: { ok: 0, fail: 0, errors: [] },
};

function log(line) {
  if (!jsonMode) process.stdout.write(line + '\n');
}

function listFiles(dir, exts) {
  if (!fs.existsSync(dir)) return [];
  return fs.readdirSync(dir, { withFileTypes: true })
    .filter(d => d.isFile() && exts.some(e => d.name.endsWith(e)))
    .map(d => path.join(dir, d.name));
}

function listDirs(dir) {
  if (!fs.existsSync(dir)) return [];
  return fs.readdirSync(dir, { withFileTypes: true })
    .filter(d => d.isDirectory())
    .map(d => path.join(dir, d.name));
}

// ── 1. Parse all JS/MJS files ────────────────────────────────────────────────
log('=== 1. Parse JS/MJS files ===');
const jsFiles = [
  ...listFiles(path.join(PLUGIN_ROOT, 'hooks'), ['.js']),
  ...listFiles(path.join(PLUGIN_ROOT, 'hooks', 'lib'), ['.js']),
  ...listFiles(path.join(PLUGIN_ROOT, 'scripts'), ['.mjs', '.js']),
  ...listFiles(path.join(PLUGIN_ROOT, 'scripts', 'lib'), ['.mjs', '.js']),
  ...listFiles(path.join(PLUGIN_ROOT, 'monitors'), ['.mjs', '.js']),
];
for (const fp of jsFiles) {
  const r = spawnSync(process.execPath, ['--check', fp], { encoding: 'utf8' });
  if (r.status === 0) {
    results.parse.ok++;
  } else {
    results.parse.fail++;
    results.parse.errors.push({ file: path.relative(PLUGIN_ROOT, fp), error: r.stderr.trim() });
  }
}
log(`  ${results.parse.ok} parsed OK | ${results.parse.fail} failed`);
results.parse.errors.forEach(e => log(`    FAIL: ${e.file}\n      ${e.error.split('\n')[0]}`));

// ── 2. JSON config validation ────────────────────────────────────────────────
log('\n=== 2. JSON configs ===');
const configs = [
  { path: path.join(PLUGIN_ROOT, '.claude-plugin', 'plugin.json'),
    label: 'plugin.json',
    validate: (j) => {
      if (!j.name) throw new Error('missing name');
      if (!j.description) throw new Error('missing description');
      return `v${j.version} | ${j.name}`;
    } },
  { path: path.join(PLUGIN_ROOT, 'hooks', 'hooks.json'),
    label: 'hooks.json',
    validate: (j) => {
      if (!j.hooks || typeof j.hooks !== 'object') throw new Error('missing top-level "hooks" wrapper');
      const events = Object.keys(j.hooks);
      const total = events.reduce((s, e) => s + j.hooks[e].reduce((s2, g) => s2 + (g.hooks || []).length, 0), 0);
      return `${events.length} events, ${total} hooks`;
    } },
  { path: path.join(PLUGIN_ROOT, 'monitors', 'monitors.json'),
    label: 'monitors.json',
    validate: (j) => {
      if (!Array.isArray(j)) throw new Error('expected array');
      for (const m of j) {
        if (!m.name || !m.command) throw new Error(`monitor missing name or command: ${JSON.stringify(m)}`);
      }
      return `${j.length} monitors`;
    } },
];
for (const cfg of configs) {
  if (!fs.existsSync(cfg.path)) continue;
  try {
    const j = JSON.parse(fs.readFileSync(cfg.path, 'utf8'));
    const summary = cfg.validate(j);
    log(`  OK: ${cfg.label} — ${summary}`);
    results.configs.ok++;
  } catch (e) {
    log(`  FAIL: ${cfg.label} — ${e.message}`);
    results.configs.fail++;
    results.configs.errors.push({ file: cfg.label, error: e.message });
  }
}

// ── 3. Frontmatter check on skills + agents ──────────────────────────────────
log('\n=== 3. Frontmatter on skills + agents ===');
function checkFrontmatter(filePath) {
  const src = fs.readFileSync(filePath, 'utf8');
  const lines = src.split('\n');
  if (lines[0].trim() !== '---') return { ok: false, error: 'no opening ---' };
  let endIdx = -1;
  for (let i = 1; i < lines.length; i++) {
    if (lines[i].trim() === '---') { endIdx = i; break; }
  }
  if (endIdx === -1) return { ok: false, error: 'no closing ---' };
  const fm = lines.slice(1, endIdx).join('\n');
  if (!/^description:/m.test(fm)) return { ok: false, error: 'missing description' };
  return { ok: true };
}
for (const skillDir of listDirs(path.join(PLUGIN_ROOT, 'skills'))) {
  const skillMd = path.join(skillDir, 'SKILL.md');
  const name = `skills/${path.basename(skillDir)}`;
  if (!fs.existsSync(skillMd)) {
    results.frontmatter.fail++;
    results.frontmatter.errors.push({ file: name, error: 'no SKILL.md' });
    log(`  FAIL: ${name} — no SKILL.md`);
    continue;
  }
  const r = checkFrontmatter(skillMd);
  if (r.ok) {
    results.frontmatter.ok++;
  } else {
    results.frontmatter.fail++;
    results.frontmatter.errors.push({ file: name, error: r.error });
    log(`  FAIL: ${name} — ${r.error}`);
  }
}
for (const agentMd of listFiles(path.join(PLUGIN_ROOT, 'agents'), ['.md'])) {
  const name = `agents/${path.basename(agentMd)}`;
  const r = checkFrontmatter(agentMd);
  if (r.ok) {
    results.frontmatter.ok++;
  } else {
    results.frontmatter.fail++;
    results.frontmatter.errors.push({ file: name, error: r.error });
    log(`  FAIL: ${name} — ${r.error}`);
  }
}
log(`  ${results.frontmatter.ok} OK | ${results.frontmatter.fail} failed`);

// ── 4. Run each hook with mock stdin (verify no crashes) ─────────────────────
log('\n=== 4. Run each hook with mock stdin ===');
// cp-ww6: run against an ISOLATED temp cwd, not PLUGIN_ROOT. With PLUGIN_ROOT,
// session-export-qmd.js resolved this repo's real ~/.claude/projects session
// and did production work on every run — wrote a transcript into the vault and
// ran a synchronous `qmd update -c vault` that occasionally blew the 15s timeout
// (flaky fail) and polluted the vault during a smoke test. A throwaway cwd has
// no projects JSONL (export skips) while a `.beads` marker still lets the
// beads-aware hooks exercise their context-detection path.
const smokeCwd = fs.mkdtempSync(path.join(os.tmpdir(), 'braynee-smoke-'));
fs.mkdirSync(path.join(smokeCwd, '.beads'), { recursive: true });
// cp-9qq: isolate the VAULT too. Many hooks (session-auto-track, vault-changelog,
// memory-index-sync, session-export-qmd, …) resolve getVaultRoot(); without an
// override that is the REAL vault, so this mock run auto-created a
// `1. Projects/Braynee Smoke <id>.md` stub in it on EVERY self-test run and never
// cleaned it up. Point BRAYNEE_VAULT at a throwaway vault so all vault writes land
// in a temp dir that is removed below.
const smokeVault = fs.mkdtempSync(path.join(os.tmpdir(), 'braynee-smoke-vault-'));
fs.mkdirSync(path.join(smokeVault, '.obsidian'), { recursive: true });
fs.mkdirSync(path.join(smokeVault, '1. Projects'), { recursive: true });
fs.mkdirSync(path.join(smokeVault, '2. Areas', 'Sessions'), { recursive: true });
const mockInput = JSON.stringify({
  session_id: 'self-test',
  cwd: smokeCwd,
  source: 'self-test',
  tool_name: 'Write',
  tool_input: { file_path: path.join(smokeCwd, 'self-test'), command: 'echo test' },
});
for (const hookFile of listFiles(path.join(PLUGIN_ROOT, 'hooks'), ['.js'])) {
  const name = path.basename(hookFile);
  // *.test.js are unit tests (run in section 7), not hooks — don't invoke them
  // here with mock stdin (they'd run their suite and muddy this section).
  if (name.endsWith('.test.js') || name.endsWith('.test.mjs')) continue;
  const r = spawnSync(process.execPath, [hookFile], {
    input: mockInput,
    encoding: 'utf8',
    timeout: 15_000,
    env: { ...process.env, BRAYNEE_VAULT: smokeVault },
  });
  // Hooks are allowed to exit 0 (success) or 2 (blocking). Anything else is a crash.
  if (r.status === 0 || r.status === 2) {
    results.hooks.ok++;
  } else {
    results.hooks.fail++;
    const err = (r.stderr || r.stdout || '').split('\n').slice(0, 3).join(' | ');
    results.hooks.errors.push({ file: name, status: r.status, error: err });
    log(`  CRASH: ${name} (exit ${r.status}) — ${err}`);
  }
}
try { fs.rmSync(smokeCwd, { recursive: true, force: true }); } catch {}
try { fs.rmSync(smokeVault, { recursive: true, force: true }); } catch {}
log(`  ${results.hooks.ok} ran cleanly | ${results.hooks.fail} crashed`);

// ── 5. Boot-test each monitor (verify it can start) ──────────────────────────
log('\n=== 5. Boot-test monitors ===');
for (const monFile of listFiles(path.join(PLUGIN_ROOT, 'monitors'), ['.mjs', '.js'])) {
  const name = path.basename(monFile);
  const r = spawnSync(process.execPath, [monFile], { encoding: 'utf8', timeout: 3_000 });
  // Monitors run forever. Timeout signal is expected; what matters is that they didn't fail to start.
  // signal === 'SIGTERM' means we killed them after 3s — that's fine (they were still running).
  // status 0 means they exited cleanly (likely because the watched thing wasn't found — also fine).
  if (r.signal === 'SIGTERM' || r.status === 0) {
    results.monitors.ok++;
  } else {
    results.monitors.fail++;
    results.monitors.errors.push({ file: name, status: r.status, signal: r.signal, error: (r.stderr || '').slice(0, 200) });
    log(`  FAIL: ${name} (exit ${r.status} signal ${r.signal})`);
  }
}
log(`  ${results.monitors.ok} started OK | ${results.monitors.fail} failed`);

// ── 6. Bundled scripts dispatch ──────────────────────────────────────────────
log('\n=== 6. Bundled scripts ===');
const scripts = [
  { file: 'qmd-wrapper.mjs', args: ['--help'], expectExit: [0, 1, 127] },
  { file: 'vault-query.mjs', args: ['--help'], expectExit: [0, 1] },
  { file: 'beads-dashboard.js', args: ['--help'], expectExit: [0, 1] },
];
for (const s of scripts) {
  const fp = path.join(PLUGIN_ROOT, 'scripts', s.file);
  if (!fs.existsSync(fp)) {
    results.scripts.fail++;
    results.scripts.errors.push({ file: s.file, error: 'not found' });
    log(`  FAIL: ${s.file} — not found`);
    continue;
  }
  const r = spawnSync(process.execPath, [fp, ...s.args], { encoding: 'utf8', timeout: 10_000 });
  if (s.expectExit.includes(r.status)) {
    results.scripts.ok++;
    log(`  OK: ${s.file} (exit ${r.status})`);
  } else {
    results.scripts.fail++;
    results.scripts.errors.push({ file: s.file, status: r.status, error: (r.stderr || r.stdout).slice(0, 200) });
    log(`  FAIL: ${s.file} — exit ${r.status}`);
  }
}

// ── 7. Unit tests (lib/*.test.js under hooks/ and scripts/) ──────────────────
log('\n=== 7. Unit tests ===');
const testFiles = [
  ...listFiles(path.join(PLUGIN_ROOT, 'hooks'), ['.test.js', '.test.mjs']),
  ...listFiles(path.join(PLUGIN_ROOT, 'hooks', 'lib'), ['.test.js', '.test.mjs']),
  ...listFiles(path.join(PLUGIN_ROOT, 'scripts', 'lib'), ['.test.js', '.test.mjs']),
];
if (testFiles.length === 0) {
  log('  (no unit tests found)');
}
for (const tf of testFiles) {
  const name = path.relative(PLUGIN_ROOT, tf);
  const r = spawnSync(process.execPath, [tf], { encoding: 'utf8', timeout: 30_000 });
  if (r.status === 0) {
    results.unit.ok++;
    log(`  OK: ${name} — ${(r.stdout || '').trim().split('\n').pop()}`);
  } else {
    results.unit.fail++;
    const err = ((r.stderr || '') + (r.stdout || '')).split('\n').filter(Boolean).slice(-4).join(' | ');
    results.unit.errors.push({ file: name, status: r.status, error: err });
    log(`  FAIL: ${name} (exit ${r.status}) — ${err}`);
  }
}

// ── 8. Gated-hook output assertions (cp-068 / cp-cpp) ────────────────────────
// The Claude Code hook `if` field proved version-unreliable (CC 2.1.143 never
// fires an if-gated hook; older CC ignores `if` and fires it on every Bash). So
// every beads/mtn Bash hook now registers WITHOUT `if` and MUST self-gate in JS.
// Step 4 only proves "doesn't crash"; these assertions prove the gate actually
// works — emit on a matching command, stay SILENT on a non-matching one. A
// regression here is exactly the bug class that silently broke the task mirror.
log('\n=== 8. Gated-hook output assertions ===');

// Temp cwd containing a .beads marker so the `.beads` existsSync gate passes
// without touching any real repo.
const gateCwd = fs.mkdtempSync(path.join(os.tmpdir(), 'braynee-gate-'));
fs.mkdirSync(path.join(gateCwd, '.beads'), { recursive: true });

function runHook(hookRel, command, toolResponse) {
  const payload = {
    session_id: 'self-test', cwd: gateCwd, source: 'self-test',
    tool_name: 'Bash', tool_input: { command },
  };
  if (toolResponse) payload.tool_response = toolResponse;
  const r = spawnSync(process.execPath, [path.join(PLUGIN_ROOT, 'hooks', hookRel)], {
    input: JSON.stringify(payload), encoding: 'utf8', timeout: 15_000,
  });
  return { out: (r.stdout || ''), status: r.status };
}

function assertGate(label, cond) {
  if (cond) { results.gating.ok++; log(`  OK: ${label}`); }
  else { results.gating.fail++; results.gating.errors.push({ test: label }); log(`  FAIL: ${label}`); }
}

// beads-todo-reminder.js — the mirror-critical, side-effect-free hook. Must emit
// hookSpecificOutput.additionalContext for each bd state-change, silence otherwise.
{
  const create = runHook('beads-todo-reminder.js', 'bd create --title="Gate test"',
    { stdout: '✓ Created issue: tt-1 — Gate test\n' });
  assertGate('beads-todo-reminder emits on `bd create` (additionalContext + id)',
    create.out.includes('additionalContext') && create.out.includes('tt-1'));

  const claim = runHook('beads-todo-reminder.js', 'bd update tt-1 --claim');
  assertGate('beads-todo-reminder emits on `bd update --claim` (in_progress)',
    claim.out.includes('additionalContext') && /in_progress/.test(claim.out));

  const close = runHook('beads-todo-reminder.js', 'bd close tt-1');
  assertGate('beads-todo-reminder emits on `bd close` (closed)',
    close.out.includes('additionalContext') && /closed/.test(close.out));

  const noise = runHook('beads-todo-reminder.js', 'echo hello world');
  assertGate('beads-todo-reminder stays SILENT on a non-bd command',
    noise.out.trim() === '' && (noise.status === 0 || noise.status === 2));
}

// The remaining gated Bash hooks side-effect on a match (timers, branches,
// session notes), so only assert the property we now depend on: a non-matching
// command produces no stdout and a clean exit (the self-gate fires first).
for (const h of ['commit-cadence-nudge.js', 'beads-claim-to-branch.js',
                 'beads-status-sync.js', 'beads-dashboard-refresh.js', 'mtn-to-beads-sync.js',
                 'beads-close-gate.js']) {
  const noise = runHook(h, 'echo hello world');
  assertGate(`${h} stays SILENT + exit 0 on a non-matching command`,
    noise.out.trim() === '' && (noise.status === 0 || noise.status === 2));
}

// beads-close-gate.js (cp-9f2.5) — must NEVER block when it can't read the
// target issue (bd absent/uninitialized): a `bd close` against a bare-marker
// repo stays silent + non-blocking. The flag/block decision itself is unit-
// tested in §7; here we lock the graceful "don't get in the way" contract.
{
  const r = runHook('beads-close-gate.js', 'bd close zz-000 --reason "x"');
  assertGate('beads-close-gate stays SILENT when the target issue is unreadable (bare-marker repo)',
    r.out.trim() === '' && (r.status === 0 || r.status === 2));
}

// secret-exposure-guard.js — DENY value-printing secret commands (exit 2 + stderr),
// ALLOW injection (`infisical run`) and writes (`secrets set`), stay SILENT on a
// non-match, and DENY real secrets written into a .env file. Locks the contract
// that secret values never reach the transcript.
function runGuard(payload) {
  const r = spawnSync(process.execPath, [path.join(PLUGIN_ROOT, 'hooks', 'secret-exposure-guard.js')], {
    input: JSON.stringify({ session_id: 'self-test', cwd: gateCwd, ...payload }),
    encoding: 'utf8', timeout: 15_000,
  });
  return { out: r.stdout || '', err: r.stderr || '', status: r.status };
}
{
  const bash = (command) => runGuard({ tool_name: 'Bash', tool_input: { command } });
  const write = (file_path, content) => runGuard({ tool_name: 'Write', tool_input: { file_path, content } });

  assertGate('secret-exposure-guard BLOCKS `infisical secrets get`',
    bash('infisical secrets get OPENAI_API_KEY --plain').status === 2);
  assertGate('secret-exposure-guard BLOCKS `infisical export`',
    bash('infisical export --env=dev').status === 2);
  assertGate('secret-exposure-guard BLOCKS bare `infisical secrets` (list with values)',
    bash('infisical secrets --recursive').status === 2);
  assertGate('secret-exposure-guard BLOCKS `vault kv get`',
    bash('vault kv get secret/foo').status === 2);
  assertGate('secret-exposure-guard ALLOWS `infisical run` (injection)',
    bash('infisical run --recursive --silent -- node app.js').status === 0);
  assertGate('secret-exposure-guard ALLOWS `infisical secrets set` (write by ref, no value printed)',
    bash('infisical secrets set NEWKEY="$EXISTING"').status === 0);
  assertGate('secret-exposure-guard stays SILENT + exit 0 on a non-matching command',
    (() => { const r = bash('echo hello world'); return r.out.trim() === '' && r.err.trim() === '' && r.status === 0; })());
  assertGate('secret-exposure-guard BLOCKS a real secret written to .env',
    write(path.join(gateCwd, '.env'), 'OPENAI_API_KEY=sk-' + 'a'.repeat(48) + '\n').status === 2);
  assertGate('secret-exposure-guard ALLOWS a placeholder in .env',
    write(path.join(gateCwd, '.env'), 'OPENAI_API_KEY=YOUR_KEY_HERE\n').status === 0);
}

// vault-search-guard.js (cp-m3g) — DENY Glob/Grep/Bash-search aimed at the vault
// (steer to QMD), ALLOW the identical search in a code repo. Locks the contract
// that vault content is searched via QMD, never a cwd-sensitive filesystem tool.
{
  const vaultDir = fs.mkdtempSync(path.join(os.tmpdir(), 'braynee-vault-'));
  const codeDir = fs.mkdtempSync(path.join(os.tmpdir(), 'braynee-code-'));
  const runVG = (payload, cwd) => spawnSync(
    process.execPath, [path.join(PLUGIN_ROOT, 'hooks', 'vault-search-guard.js')],
    {
      input: JSON.stringify({ session_id: 'self-test', cwd: cwd || codeDir, ...payload }),
      encoding: 'utf8', timeout: 15_000,
      env: { ...process.env, BRAYNEE_VAULT: vaultDir, BRAYNEE_ALLOW_VAULT_GREP: '' },
    });
  try {
    assertGate('vault-search-guard BLOCKS Glob with a vault path',
      runVG({ tool_name: 'Glob', tool_input: { pattern: '**/*.md', path: vaultDir } }).status === 2);
    assertGate('vault-search-guard ALLOWS Glob with a code-repo path',
      runVG({ tool_name: 'Glob', tool_input: { pattern: '**/*.ts', path: codeDir } }).status === 0);
    assertGate('vault-search-guard BLOCKS path-less Grep when cwd is the vault',
      runVG({ tool_name: 'Grep', tool_input: { pattern: 'foo' } }, vaultDir).status === 2);
    assertGate('vault-search-guard ALLOWS path-less Grep when cwd is a code repo',
      runVG({ tool_name: 'Grep', tool_input: { pattern: 'foo' } }, codeDir).status === 0);
    assertGate('vault-search-guard BLOCKS `grep` of an explicit vault path',
      runVG({ tool_name: 'Bash', tool_input: { command: `grep -r foo "${vaultDir}/notes"` } }).status === 2);
    assertGate('vault-search-guard ALLOWS a stdout filter `qmd … | grep -v` (no vault path)',
      runVG({ tool_name: 'Bash', tool_input: { command: 'node qmd-wrapper.mjs search x | grep -v transcript' } }, vaultDir).status === 0);
    assertGate('vault-search-guard ALLOWS `grep -r` in a code repo',
      runVG({ tool_name: 'Bash', tool_input: { command: 'grep -r foo .' } }, codeDir).status === 0);
    assertGate('vault-search-guard stays SILENT + exit 0 on a non-search Bash command',
      runVG({ tool_name: 'Bash', tool_input: { command: 'echo hello' } }, vaultDir).status === 0);
  } finally {
    try { fs.rmSync(vaultDir, { recursive: true, force: true }); } catch {}
    try { fs.rmSync(codeDir, { recursive: true, force: true }); } catch {}
  }
}

// beads-server-heal.js — SessionStart heal (cp-6j5). The kill path only runs
// against a REAL initialized .beads/; against a bare marker dir (no metadata/
// config/issues/dolt) it must stay completely silent and exit 0, so it never
// touches a server during a smoke run. (No session_id → sessionDir uses cwd
// directly, bypassing the cross-section anchor cache.)
{
  const r = spawnSync(process.execPath, [path.join(PLUGIN_ROOT, 'hooks', 'beads-server-heal.js')], {
    input: JSON.stringify({ cwd: gateCwd, source: 'self-test' }),
    encoding: 'utf8', timeout: 15_000,
  });
  assertGate('beads-server-heal stays SILENT + exit 0 on a bare-marker .beads/',
    (r.stdout || '').trim() === '' && (r.status === 0 || r.status === 2));
}

try { fs.rmSync(gateCwd, { recursive: true, force: true }); } catch {}
log(`  ${results.gating.ok} passed | ${results.gating.fail} failed`);

// ── 9. windowsHide on every process spawn (cp-x01) ───────────────────────────
// Hooks/scripts run from a console-less parent; a string execSync (which wraps
// in cmd.exe) or a child .cmd shim (npm, etc.) without windowsHide:true flashes
// a console window on Windows. braynee's convention is windowsHide on EVERY
// spawn — this scans for offenders so the flash class can't silently regress.
log('\n=== 9. windowsHide on every spawn ===');
results.winhide = { ok: 0, fail: 0, errors: [] };
function walkCode(dir) {
  const out = [];
  for (const e of (fs.existsSync(dir) ? fs.readdirSync(dir, { withFileTypes: true }) : [])) {
    if (e.name === 'node_modules' || e.name.startsWith('.')) continue;
    const fp = path.join(dir, e.name);
    if (e.isDirectory()) out.push(...walkCode(fp));
    else if (/\.(js|mjs)$/.test(e.name) && !/\.test\.(js|mjs)$/.test(e.name)) out.push(fp);
  }
  return out;
}
const SPAWN_RE = /\b(execSync|spawnSync|spawn|exec)\s*\(/g;
for (const fp of [...walkCode(path.join(PLUGIN_ROOT, 'hooks')), ...walkCode(path.join(PLUGIN_ROOT, 'scripts'))]) {
  const text = fs.readFileSync(fp, 'utf8');
  let m, bad = 0;
  while ((m = SPAWN_RE.exec(text))) {
    // Extract exactly this call — from its open paren to the matching close —
    // via balanced-paren scan, so the check never bleeds into the next call.
    const open = text.indexOf('(', m.index);
    if (open === -1) continue;
    let depth = 0, end = open;
    for (let i = open; i < text.length && i < open + 2000; i++) {
      const c = text[i];
      if (c === '(') depth++;
      else if (c === ')') { depth--; if (depth === 0) { end = i; break; } }
    }
    const call = text.slice(open, end + 1);
    // Only flag calls that pass an INLINE options object literal but omit
    // windowsHide. Calls that pass a shared const (e.g. EXEC) or spread one
    // (`{ ...EXEC }`) inherit its windowsHide; shell:false is hook-sandbox's
    // intentional dev spawn. Bare identifier-options calls are the const's job.
    if (!/\{/.test(call)) continue;
    if (/windowsHide\s*:\s*true/.test(call) || /shell\s*:\s*false/.test(call)) continue;
    if (/\.\.\.[A-Za-z_$][\w$]*/.test(call)) continue;
    bad++;
  }
  if (bad === 0) { results.winhide.ok++; }
  else {
    results.winhide.fail++;
    const rel = path.relative(PLUGIN_ROOT, fp);
    results.winhide.errors.push({ file: rel, missing: bad });
    log(`  FAIL: ${rel} — ${bad} spawn(s) without windowsHide`);
  }
}
log(`  ${results.winhide.ok} files clean | ${results.winhide.fail} with un-hidden spawns`);

// ── 10. Agent definition assertions (autopilot) ──────────────────────────────
// Locks two autopilot.md regressions:
//  - cp-9f2.1: the model must not be re-pinned to Haiku — a build-to-ship run
//    needs the session model (model: inherit), not the old hardcoded haiku.
//  - cp-9f2.7: every bd command must use a flag that exists on the installed bd.
//    `bd update --add-note` and `bd dep add ... --kind` are NOT real flags; they
//    print help and silently no-op, so the agent's note/dep steps never persist.
log('\n=== 10. Agent definition assertions ===');
results.agents = { ok: 0, fail: 0, errors: [] };
function assertAgent(label, cond) {
  if (cond) { results.agents.ok++; log(`  OK: ${label}`); }
  else { results.agents.fail++; results.agents.errors.push({ test: label }); log(`  FAIL: ${label}`); }
}
{
  const apPath = path.join(PLUGIN_ROOT, 'agents', 'autopilot.md');
  const ap = fs.existsSync(apPath) ? fs.readFileSync(apPath, 'utf8') : '';
  const modelMatch = ap.match(/^model:\s*(\S+)\s*$/m);
  assertAgent('autopilot.md declares a model', !!modelMatch);
  assertAgent('autopilot.md model is not pinned to haiku (cp-9f2.1)',
    !!modelMatch && modelMatch[1] !== 'haiku');
  assertAgent('autopilot.md uses no `--add-note` flag (cp-9f2.7)',
    !/\bbd\b[^\n]*--add-note\b/.test(ap));
  assertAgent('autopilot.md has no `bd dep add ... --kind` on one line (cp-9f2.7)',
    !/bd dep add[^\n]*--kind\b/.test(ap));
  assertAgent('autopilot.md documents a local quality gate (biome + Tier-1, hard-stop on red) (cp-9f2.6)',
    /biome check/i.test(ap) && /tier-1/i.test(ap) && /red gate is a hard stop/i.test(ap));
  assertAgent('autopilot.md ship mode is opt-in + prod stays human-gated (cp-9f2.2)',
    /ship mode \(opt-in/i.test(ap) && /double opt-in/i.test(ap) && /human-gated/i.test(ap));
}
{
  // cp-ci9.2: the beads-auditor must hold its key contracts — tool-restricted,
  // warns about the bd batch-write clobber, enforces supersede, gates writes on approval.
  const baPath = path.join(PLUGIN_ROOT, 'agents', 'beads-auditor.md');
  const ba = fs.existsSync(baPath) ? fs.readFileSync(baPath, 'utf8') : '';
  assertAgent('beads-auditor.md exists (cp-ci9.2)', !!ba);
  assertAgent('beads-auditor declares tools + model', /^tools:/m.test(ba) && /^model:/m.test(ba));
  assertAgent('beads-auditor warns about the bd batch-write flush (clobber gotcha)',
    /bd export --all --include-memories/.test(ba));
  assertAgent('beads-auditor enforces supersede for reversed decisions',
    /supersede/i.test(ba));
  assertAgent('beads-auditor gates mutations on approval',
    /only after approval|only on approval|go-ahead/i.test(ba));
}
log(`  ${results.agents.ok} passed | ${results.agents.fail} failed`);

// ── 11. Rules-template assertions (cp-ci9.1) ─────────────────────────────────
// The beads-conventions rule must ship in rules-templates (cmd_rules globs *.md,
// so presence here = it installs) and carry the discipline it exists to enforce.
log('\n=== 11. Rules-template assertions ===');
results.rules = { ok: 0, fail: 0, errors: [] };
function assertRule(label, cond) {
  if (cond) { results.rules.ok++; log(`  OK: ${label}`); }
  else { results.rules.fail++; results.rules.errors.push({ test: label }); log(`  FAIL: ${label}`); }
}
{
  const rp = path.join(PLUGIN_ROOT, 'skills', 'setup', 'rules-templates', 'beads-conventions.md');
  const r = fs.existsSync(rp) ? fs.readFileSync(rp, 'utf8') : '';
  assertRule('beads-conventions.md ships in rules-templates (cp-ci9.1)', !!r);
  assertRule('beads-conventions.md is a path-scoped rule (paths: frontmatter)',
    /^---[\r\n]+paths:/.test(r));
  assertRule('beads-conventions states the in/out boundary (bd remember + TodoWrite + vault)',
    /bd remember/i.test(r) && /TodoWrite/i.test(r) && /vault/i.test(r));
  assertRule('beads-conventions carries the design-vs-acceptance rule',
    /design/i.test(r) && /acceptance/i.test(r) && /verifiable/i.test(r));
  assertRule('beads-conventions says supersede reversed decisions (not silent-delete)',
    /supersede/i.test(r));
  assertRule('beads-conventions documents the create-time guard (validation.on-create)',
    /validation\.on-create/i.test(r));
}
log(`  ${results.rules.ok} passed | ${results.rules.fail} failed`);

// ── 12. Health beads-hygiene assertion (cp-ci9.3) ────────────────────────────
// /health's Beads check must surface traceability drift (not just secrets):
// missing sections, orphans, stale, and the create-time guard.
log('\n=== 12. Health beads-hygiene assertion ===');
results.health = { ok: 0, fail: 0, errors: [] };
function assertHealth(label, cond) {
  if (cond) { results.health.ok++; log(`  OK: ${label}`); }
  else { results.health.fail++; results.health.errors.push({ test: label }); log(`  FAIL: ${label}`); }
}
{
  const hpPath = path.join(PLUGIN_ROOT, 'skills', 'health', 'scripts', 'health.py');
  const hp = fs.existsSync(hpPath) ? fs.readFileSync(hpPath, 'utf8') : '';
  assertHealth('health.py cmd_beads emits a traceability line (cp-ci9.3)', /traceability:/.test(hp));
  assertHealth('health.py hygiene runs lint + orphans + stale + guard',
    /_bd\("lint"\)/.test(hp) && /_bd\("orphans"\)/.test(hp) && /_bd\("stale"\)/.test(hp) && /validation\.on-create/.test(hp));
}
log(`  ${results.health.ok} passed | ${results.health.fail} failed`);

// ── Summary ──────────────────────────────────────────────────────────────────
const totalOk = Object.values(results).reduce((s, r) => s + r.ok, 0);
const totalFail = Object.values(results).reduce((s, r) => s + r.fail, 0);

log('\n=== Summary ===');
log(`  Plugin root: ${PLUGIN_ROOT}`);
log(`  Platform: ${process.platform} | Node: ${process.version}`);
log(`  Results: ${totalOk} passed, ${totalFail} failed`);

if (jsonMode) {
  process.stdout.write(JSON.stringify({
    ok: totalFail === 0,
    pluginRoot: PLUGIN_ROOT,
    platform: process.platform,
    node: process.version,
    totals: { ok: totalOk, fail: totalFail },
    results,
  }, null, 2) + '\n');
}

process.exit(totalFail === 0 ? 0 : 1);
